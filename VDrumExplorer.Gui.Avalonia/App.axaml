<Application xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="clr-namespace:VDrumExplorer.ViewModel;assembly=VDrumExplorer.ViewModel"
            x:Class="VDrumExplorer.Gui.Avalonia.App"
            RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://VDrumExplorer.Gui.Avalonia/Styles/RegularScaling.axaml" />
        <StyleInclude Source="avares://VDrumExplorer.Gui.Avalonia/Styles/ModernStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
                    <SolidColorBrush x:Key="AccentColor" Color="#6366F1" />
                    <SolidColorBrush x:Key="AccentColorHover" Color="#5558E0" />
                    <SolidColorBrush x:Key="AccentColorLight" Color="#EEF0FF" />
                    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LogBackground" Color="#1E1E2E" />
                    <SolidColorBrush x:Key="LogForeground" Color="#A9B1D6" />
                    <SolidColorBrush x:Key="SeparatorColor" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="SuccessColor" Color="#10B981" />
                    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" />
                    <SolidColorBrush x:Key="ErrorColor" Color="#EF4444" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#1A1B1E" />
                    <SolidColorBrush x:Key="CardBackground" Color="#25262A" />
                    <SolidColorBrush x:Key="CardBorder" Color="#374151" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="AccentColor" Color="#6366F1" />
                    <SolidColorBrush x:Key="AccentColorHover" Color="#5558E0" />
                    <SolidColorBrush x:Key="AccentColorLight" Color="#312E5F" />
                    <SolidColorBrush x:Key="ToolbarBackground" Color="#25262A" />
                    <SolidColorBrush x:Key="LogBackground" Color="#0D0D14" />
                    <SolidColorBrush x:Key="LogForeground" Color="#A9B1D6" />
                    <SolidColorBrush x:Key="SeparatorColor" Color="#374151" />
                    <SolidColorBrush x:Key="SuccessColor" Color="#10B981" />
                    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" />
                    <SolidColorBrush x:Key="ErrorColor" Color="#EF4444" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="InputCornerRadius">4</CornerRadius>

            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardMargin">0,0,0,12</Thickness>

            <Thickness x:Key="ValueMargin">10,0,0,0</Thickness>
            <Thickness x:Key="ValueMarginWithVertical">10,3,0,3</Thickness>
            <Thickness x:Key="ValueMarginWithMarginAbove">10,3,0,0</Thickness>
            <Thickness x:Key="PanelMargin">0,5,0,0</Thickness>
            <Thickness x:Key="AllAroundMargin">5,5,5,5</Thickness>

            <DataTemplate x:Key="KeyValueItemTemplate" x:DataType="vm:KeyValueViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Col0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Key}" ToolTip.Tip="{Binding KeyToolTip}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="{StaticResource ValueMargin}" ToolTip.Tip="{Binding ValueToolTip}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>