<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmd="clr-namespace:VDrumExplorer.ViewModel.Dialogs;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.Dialogs.MultiPasteDialog"
        x:CompileBindings="True"
        x:DataType="vmd:MultiPasteViewModel"
        Title="Multi-paste" Height="450" Width="500"
        CanResize="False">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Node snapshot path:" />
            <TextBlock Margin="{StaticResource ValueMargin}" Text="{Binding Snapshot.Path}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource PanelMargin}">
            <TextBlock Text="Select nodes to paste the snapshot into, then click &quot;Paste&quot;." />
        </StackPanel>
        <UniformGrid Rows="1" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="{StaticResource PanelMargin}">
            <Button Click="SelectAll" VerticalAlignment="Center" Content="Select all" />
            <Button Margin="{StaticResource ValueMargin}" Click="SelectNone" VerticalAlignment="Center" Content="Select none" />
        </UniformGrid>
        <UniformGrid Rows="1" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="{StaticResource PanelMargin}">
            <Button Click="Paste" VerticalAlignment="Center" Content="Paste" />
            <Button Margin="{StaticResource ValueMargin}" Click="Cancel" VerticalAlignment="Center" Content="Cancel" />
        </UniformGrid>
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Candidates}" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vmd:MultiPasteViewModel+CheckableCandidate">
                    <StackPanel>
                        <CheckBox Content="{Binding Candidate.Path}" IsChecked="{Binding Checked}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
