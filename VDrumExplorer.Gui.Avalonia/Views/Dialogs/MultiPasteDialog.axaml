<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmd="clr-namespace:VDrumExplorer.ViewModel.Dialogs;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.Dialogs.MultiPasteDialog"
        x:CompileBindings="True"
        x:DataType="vmd:MultiPasteViewModel"
        Title="Multi-paste" Height="500" Width="550"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Classes="label" Text="Node snapshot path:" />
            <TextBlock Margin="8,0,0,0" Text="{Binding Snapshot.Path}" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,8" Text="Select nodes to paste the snapshot into, then click Paste." />
        <UniformGrid Rows="1" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button Click="SelectAll" Content="Select all" />
            <Button Margin="8,0,0,0" Click="SelectNone" Content="Select none" />
        </UniformGrid>
        <UniformGrid Rows="1" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Classes="accent" Click="Paste" Content="Paste" />
            <Button Margin="8,0,0,0" Click="Cancel" Content="Cancel" />
        </UniformGrid>
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Candidates}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vmd:MultiPasteViewModel+CheckableCandidate">
                    <CheckBox Content="{Binding Candidate.Path}" IsChecked="{Binding Checked}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
