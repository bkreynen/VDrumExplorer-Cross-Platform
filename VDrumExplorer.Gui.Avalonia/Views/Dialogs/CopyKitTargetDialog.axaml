<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmd="clr-namespace:VDrumExplorer.ViewModel.Dialogs;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.Dialogs.CopyKitTargetDialog"
        x:CompileBindings="True"
        x:DataType="vmd:CopyKitViewModel"
        Title="Select Destination Kit"
        SizeToContent="WidthAndHeight"
        CanResize="False">
    <Grid Margin="6,3,0,9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Source kit:" />
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Destination kit number:" />
        <TextBlock Grid.Column="0" Grid.Row="2" Text="Destination kit name:" />

        <TextBlock Grid.Column="1" Grid.Row="0"
                   Margin="{StaticResource ValueMarginWithVertical}" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Text="{Binding SourceKitName}" />
        <TextBox Grid.Column="1" Grid.Row="1"
                 Margin="{StaticResource ValueMarginWithVertical}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="30"
                 Text="{Binding DestinationKitNumber}" />
        <TextBlock Grid.Column="1" Grid.Row="2"
                   Margin="{StaticResource ValueMarginWithVertical}" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Text="{Binding DestinationKitName}" />

        <UniformGrid Rows="1" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="{StaticResource PanelMargin}">
            <Button Click="Copy" IsEnabled="{Binding CopyEnabled}" VerticalAlignment="Center" Content="Copy" />
            <Button Margin="{StaticResource ValueMargin}" Click="Cancel" VerticalAlignment="Center" Content="Cancel" />
        </UniformGrid>
    </Grid>
</Window>
