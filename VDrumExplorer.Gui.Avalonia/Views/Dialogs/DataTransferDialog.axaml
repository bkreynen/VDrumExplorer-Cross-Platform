<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmd="clr-namespace:VDrumExplorer.ViewModel.Dialogs;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.Dialogs.DataTransferDialog"
        x:CompileBindings="True"
        x:DataType="vmd:DataTransferViewModel"
        Title="{Binding Title}"
        Height="160" Width="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Closing="HandleClosing">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding ProgressDescription}" FontWeight="Medium" />
        <Grid Margin="0,12,0,0" Height="28">
            <ProgressBar Value="{Binding Completed, Mode=OneWay}" Maximum="{Binding Total}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Completed}" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text=" / " Foreground="White" />
                <TextBlock Text="{Binding Total}" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <Button Margin="0,16,0,0" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Content="Cancel" />
    </StackPanel>
</Window>
