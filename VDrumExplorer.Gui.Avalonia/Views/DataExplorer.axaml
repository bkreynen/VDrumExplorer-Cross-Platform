<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmd="clr-namespace:VDrumExplorer.ViewModel.Data;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.DataExplorer"
        x:CompileBindings="False"
        Title="{Binding Title}" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <!-- App shortcuts as declarative bindings to ViewModel commands (docs/accessibility.md §4).
         Ctrl+C/V dispatch between node copy/paste and whole-kit copy/paste (see CopyCommand /
         PasteCommand); Ctrl+Z/Y drive the undo/redo stack. Note: Avalonia evaluates KeyBindings
         before the bubbled KeyDown event, so when a details-pane TextBox has focus these app
         shortcuts take precedence over the TextBox's built-in text copy/paste/undo for any
         command whose CanExecute is true (a disabled command falls through to the TextBox). -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+K" Command="{Binding FieldSearch.OpenSearchCommand}" />
    </Window.KeyBindings>
    <!--
      Template-generated interactive controls (the TextBox inside each ComboBox theme, the
      header border of each TreeViewItem) are Avalonia theme internals, not view-authored
      controls, but A11yScanner treats them as interactive. The styles below give them
      accessible names and stable per-area AutomationIds; the generic ComboBox style comes
      first so the x:Name-scoped styles below can override it for specific pickers.
      Template-level IDs repeat across instances (one per editor role / tree node), which
      docs/accessibility.md §3.1 sanctions (Warning severity only).
    -->
    <Window.Styles>
        <!-- Inner text box of every editable ComboBox (theme internal). -->
        <Style Selector="ComboBox TextBox#PART_EditableTextBox">
            <Setter Property="AutomationProperties.Name" Value="Selected value" />
            <Setter Property="AutomationProperties.AutomationId" Value="data-explorer.details.selected-value" />
        </Style>
        <!-- Inner text box of the Midi channel picker on the device toolbar (more specific
             override of the generic style above). -->
        <Style Selector="ComboBox#midiChannelPicker TextBox#PART_EditableTextBox">
            <Setter Property="AutomationProperties.Name" Value="Selected Midi channel" />
            <Setter Property="AutomationProperties.AutomationId" Value="data-explorer.toolbar.midi-channel.selected-value" />
        </Style>
        <!-- Tree nodes: one template AutomationId per node role, name from the node title. -->
        <Style Selector="TreeViewItem">
            <Setter Property="AutomationProperties.AutomationId" Value="data-explorer.tree.node" />
        </Style>
        <!-- The focusable header border inside the TreeViewItem theme carries the node's
             announced name (the item itself derives its name from the header text). -->
        <Style Selector="TreeViewItem Border#PART_LayoutRoot">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.AutomationId" Value="data-explorer.tree.node-header" />
        </Style>
    </Window.Styles>
    <DockPanel>

        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File"
                      AutomationProperties.AutomationId="data-explorer.menu.file">
                <MenuItem Command="{Binding SaveFileCommand}" Header="Save"
                          AutomationProperties.AutomationId="data-explorer.menu.file.save"/>
                <MenuItem Command="{Binding SaveFileAsCommand}" Header="Save As"
                          AutomationProperties.AutomationId="data-explorer.menu.file.save-as"/>
                <MenuItem Command="{Binding ExportJsonCommand}" Header="Export JSON"
                          AutomationProperties.AutomationId="data-explorer.menu.file.export-json"/>
                <MenuItem Header="Convert to..." ItemsSource="{Binding ConvertibleModuleIdentifiers}" IsVisible="{Binding HasConvertibleModuleIdentifiers}"
                          AutomationProperties.AutomationId="data-explorer.menu.file.convert">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Command="{Binding $parent[Menu].DataContext.ConvertCommand}"
                                      CommandParameter="{Binding}"
                                      Header="{Binding DisplayName}"
                                      AutomationProperties.AutomationId="data-explorer.menu.file.convert-target" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Kit Number -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" IsVisible="{Binding IsKitExplorer}" Margin="16,8,16,0">
            <TextBlock Classes="label" Text="Default kit number:"/>
            <TextBox Margin="8,0,0,0" Width="50" Text="{Binding DefaultKitNumber}"
                     AutomationProperties.AutomationId="data-explorer.toolbar.kit-number-input"
                     AutomationProperties.Name="Default kit number"/>
        </StackPanel>

        <!-- Copy/Paste Toolbar -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="16,8,16,0">
            <Button Command="{Binding CopyNodeCommand}" Content="Copy node"
                    AutomationProperties.AutomationId="data-explorer.toolbar.copy-node"/>
            <Button Margin="8,0,0,0" Command="{Binding PasteNodeCommand}" Content="Paste node"
                    AutomationProperties.AutomationId="data-explorer.toolbar.paste-node"/>
            <Button Margin="8,0,0,0" Command="{Binding MultiPasteCommand}" Content="Multi-paste"
                    AutomationProperties.AutomationId="data-explorer.toolbar.multi-paste"/>
            <Button Margin="8,0,0,0" Command="{Binding RevertAllCommand}" Content="Revert all"
                    AutomationProperties.AutomationId="data-explorer.toolbar.revert-all"/>
            <Button Margin="8,0,0,0" Command="{Binding CopyMultipleKitsCommand}" IsVisible="{Binding IsModuleExplorer}" Content="Copy kits..."
                    AutomationProperties.AutomationId="data-explorer.toolbar.copy-kits"/>
            <TextBlock Classes="label" Text="Copied node path:" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding CopiedSnapshot.Path}" Margin="8,0,0,0"
                       AutomationProperties.AutomationId="data-explorer.toolbar.copied-node-path"
                       AutomationProperties.Name="Copied node path"/>
        </StackPanel>

        <!-- Device Toolbar -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" IsVisible="{Binding DeviceViewModel.DeviceConnected}" Margin="16,8,16,0">
            <Button Classes="accent" Command="{Binding CopyDataToDeviceCommand}" CommandParameter="{Binding SelectedNode}" Content="{Binding CopyDataTitle}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="data-explorer.toolbar.copy-data"/>
            <TextBlock Classes="label" Margin="16,0,0,0" IsVisible="{Binding IsKitExplorer}" VerticalAlignment="Center" Text="Kit to copy to:"/>
            <TextBox Margin="8,0,0,0" IsVisible="{Binding IsKitExplorer}" VerticalAlignment="Center" Text="{Binding KitCopyTargetNumber}" Width="50"
                     AutomationProperties.AutomationId="data-explorer.toolbar.kit-copy-target-input"
                     AutomationProperties.Name="Kit to copy to"/>
            <Button Margin="16,0,0,0" Command="{Binding PlayNoteCommand}" VerticalAlignment="Center" Content="Play note"
                    AutomationProperties.AutomationId="data-explorer.toolbar.play-note"/>
            <TextBlock Classes="label" Margin="16,0,0,0" VerticalAlignment="Center" Text="Midi Channel:"/>
            <ComboBox Margin="8,0,0,0" x:Name="midiChannelPicker" ItemsSource="{Binding MidiChannels}" SelectedItem="{Binding SelectedMidiChannel}" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="data-explorer.toolbar.midi-channel-picker"
                      AutomationProperties.Name="Midi channel"/>
            <TextBlock Classes="label" Margin="16,0,0,0" VerticalAlignment="Center" Text="Attack:"/>
            <Slider Margin="8,0,0,0" Minimum="{Binding MinAttack}" Maximum="{Binding MaxAttack}" Value="{Binding Attack}" VerticalAlignment="Center" Width="100" IsSnapToTickEnabled="True" TickFrequency="1"
                    AutomationProperties.AutomationId="data-explorer.toolbar.attack-slider"
                    AutomationProperties.Name="Attack"/>
            <TextBlock Margin="8,0,0,0" HorizontalAlignment="Left" Text="{Binding Attack}" VerticalAlignment="Center"/>
            <Button Margin="16,0,0,0" Command="{Binding CopyToTemporaryStudioSetCommand}" VerticalAlignment="Center" IsVisible="{Binding IsAerophoneKitExplorer}" Content="Test settings"
                    AutomationProperties.AutomationId="data-explorer.toolbar.test-settings"/>
        </StackPanel>

        <Separator DockPanel.Dock="Top" Margin="16,8,16,0"
                   AutomationProperties.AccessibilityView="Raw"/>

        <!--
          Status live regions (docs/accessibility.md §5–6): the polite element announces
          successful operation outcomes, the assertive element announces failures (it is
          only populated on error). Both are bound to this window's StatusViewModel; with
          empty text a TextBlock has zero height, so the visual layout is unchanged while
          the elements remain in the accessibility tree.
        -->
        <TextBlock DockPanel.Dock="Bottom"
                   AutomationProperties.AutomationId="data-explorer.status.message"
                   AutomationProperties.Name="Status"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding Status.Message}" />
        <TextBlock DockPanel.Dock="Bottom"
                   AutomationProperties.AutomationId="data-explorer.status.error"
                   AutomationProperties.Name="Status error"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding Status.ErrorMessage}" />

        <!-- Main Content: Tree + Details -->
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Tree of container nodes. -->
            <TreeView x:Name="treeView" Grid.Column="0" ItemsSource="{Binding Root}" SelectionChanged="TreeView_SelectionChanged"
                      AutomationProperties.AutomationId="data-explorer.tree"
                      AutomationProperties.LandmarkType="Navigation">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Title}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open copy in Kit Explorer" Command="{Binding Root.OpenCopyInKitExplorerCommand}" CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="data-explorer.tree.context-open-copy" />
                                    <MenuItem Header="Copy to another kit" Command="{Binding Root.CopyKitCommand}" CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="data-explorer.tree.context-copy-kit" />
                                    <MenuItem Header="Import from file" Command="{Binding Root.ImportKitFromFileCommand}" CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="data-explorer.tree.context-import-kit" />
                                    <MenuItem Header="Export to file" Command="{Binding Root.ExportKitCommand}" CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="data-explorer.tree.context-export-kit" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="data-explorer.details.splitter"
                          AutomationProperties.Name="Details pane splitter"/>

            <!--
              Jump-to-field search (Ctrl+K, docs/accessibility.md §4). Hidden by default
              (IsVisible collapses the row to zero height), so the visual layout — and the
              visual baselines — are unchanged until the search is opened. The panel is the
              Search landmark; Down/Up move between results and Enter jumps to the selected
              field, so the whole flow stays on the keyboard.
            -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            DataContext="{Binding FieldSearch}"
                            IsVisible="{Binding IsOpen}"
                            AutomationProperties.LandmarkType="Search">
                    <TextBox x:Name="fieldSearchBox"
                             Text="{Binding Query}"
                             AutomationProperties.AutomationId="data-explorer.search.box"
                             AutomationProperties.Name="Search fields"
                             AutomationProperties.HelpText="Type to search fields (Enter to jump)">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
                            <KeyBinding Gesture="Down" Command="{Binding FocusNextResultCommand}" />
                            <KeyBinding Gesture="Up" Command="{Binding FocusPreviousResultCommand}" />
                            <KeyBinding Gesture="Enter" Command="{Binding JumpToSelectedResultCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ItemsControl x:Name="fieldSearchResults" ItemsSource="{Binding Results}"
                                  IsVisible="{Binding HasResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayText}"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectSearchResultCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="data-explorer.search.result"
                                        AutomationProperties.Name="{Binding DisplayText}">
                                    <Button.KeyBindings>
                                        <KeyBinding Gesture="Escape" Command="{Binding $parent[ItemsControl].DataContext.CloseSearchCommand}" />
                                        <KeyBinding Gesture="Down" Command="{Binding $parent[ItemsControl].DataContext.FocusNextResultCommand}" />
                                        <KeyBinding Gesture="Up" Command="{Binding $parent[ItemsControl].DataContext.FocusPreviousResultCommand}" />
                                        <KeyBinding Gesture="Enter" Command="{Binding $parent[ItemsControl].DataContext.JumpToSelectedResultCommand}" />
                                    </Button.KeyBindings>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No matching fields"
                               AutomationProperties.AutomationId="data-explorer.search.no-results"
                               IsVisible="{Binding HasNoResults}" />
                </StackPanel>
                <!-- Details for the selected node. -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.LandmarkType="Main">
                    <StackPanel Margin="8,0,8,0">
                        <ItemsControl ItemsSource="{Binding SelectedNodeDetails}">
                            <ItemsControl.DataTemplates>
                                <!-- Read-only field containers -->
                                <DataTemplate DataType="vmd:FieldContainerDataNodeDetailViewModel">
                                    <GroupBox Header="{Binding Description}"
                                              AutomationProperties.HeadingLevel="3"
                                              AutomationProperties.LandmarkType="Form">
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Classes="label" Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" />
                                                        <ContentControl Grid.Column="1" Content="{Binding}" Margin="{StaticResource ValueMargin}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <ContentControl.DataTemplates>
                                                                <DataTemplate DataType="vmd:EditableEnumDataFieldViewModel">
                                                                    <ComboBox ItemsSource="{Binding ValidValues}" SelectedItem="{Binding Value}"
                                                                              AutomationProperties.AutomationId="data-explorer.details.enum-value"
                                                                              AutomationProperties.Name="{Binding Description}" />
                                                                </DataTemplate>
                                                                <DataTemplate DataType="vmd:EditableBooleanDataFieldViewModel">
                                                                    <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center"
                                                                              AutomationProperties.AutomationId="data-explorer.details.boolean-value"
                                                                              AutomationProperties.Name="{Binding Description}" />
                                                                </DataTemplate>
                                                                <DataTemplate DataType="vmd:EditableStringDataFieldViewModel">
                                                                    <TextBox Text="{Binding Text}" MaxLength="{Binding MaxLength}" MinWidth="{Binding MinWidth}"
                                                                             AutomationProperties.AutomationId="data-explorer.details.string-value"
                                                                             AutomationProperties.Name="{Binding Description}" />
                                                                </DataTemplate>
                                                                <DataTemplate DataType="vmd:EditableNumericDataFieldViewModel">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Slider Padding="0" Value="{Binding Value}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Width="250" SmallChange="1" LargeChange="{Binding LargeChange}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                                                AutomationProperties.AutomationId="data-explorer.details.numeric-slider"
                                                                                AutomationProperties.Name="{Binding Description}" />
                                                                        <TextBox Text="{Binding FormattedValue}" Width="60" Margin="{StaticResource ValueMargin}"
                                                                                 AutomationProperties.AutomationId="data-explorer.details.numeric-value"
                                                                                 AutomationProperties.Name="{Binding Description, StringFormat='{}{0} value'}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                                <DataTemplate DataType="vmd:EditableInstrumentDataFieldViewModel">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ComboBox ItemsSource="{Binding InstrumentGroups}"
                                                                                  SelectedItem="{Binding Group}"
                                                                                  VerticalAlignment="Center"
                                                                                  AutomationProperties.AutomationId="data-explorer.details.instrument-group"
                                                                                  AutomationProperties.Name="{Binding Description, StringFormat='{}{0} group'}" />
                                                                        <ComboBox ItemsSource="{Binding Group.Instruments}"
                                                                                  SelectedItem="{Binding Instrument}"
                                                                                  Margin="8,0,0,0"
                                                                                  IsVisible="{Binding IsPreset}"
                                                                                  VerticalAlignment="Center"
                                                                                  AutomationProperties.AutomationId="data-explorer.details.instrument"
                                                                                  AutomationProperties.Name="{Binding Description, StringFormat='{}{0} instrument'}" />
                                                                        <TextBlock IsVisible="{Binding IsUserSample}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="{StaticResource ValueMargin}"
                                                                                   Text="Sample number:" />
                                                                        <TextBox Text="{Binding UserSample}"
                                                                                 Width="50"
                                                                                 IsVisible="{Binding IsUserSample}"
                                                                                 Margin="{StaticResource ValueMargin}"
                                                                                 VerticalAlignment="Center"
                                                                                 AutomationProperties.AutomationId="data-explorer.details.user-sample"
                                                                                 AutomationProperties.Name="{Binding Description, StringFormat='{}{0} sample number'}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                                <DataTemplate DataType="vmd:EditableTempoDataFieldViewModel">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Tempo sync" VerticalAlignment="Center"/>
                                                                        <CheckBox IsChecked="{Binding TempoSync}" Margin="{StaticResource ValueMargin}" VerticalAlignment="Center"
                                                                                  AutomationProperties.AutomationId="data-explorer.details.tempo-sync"
                                                                                  AutomationProperties.Name="{Binding Description, StringFormat='{}{0} sync'}" />
                                                                        <ComboBox ItemsSource="{Binding ValidMusicalNoteValues}" SelectedItem="{Binding MusicalNote}" Margin="{StaticResource ValueMargin}"
                                                                                   IsVisible="{Binding TempoSync}"
                                                                                   AutomationProperties.AutomationId="data-explorer.details.tempo-note"
                                                                                   AutomationProperties.Name="{Binding Description, StringFormat='{}{0} note'}" />
                                                                        <Slider Padding="0" Value="{Binding NumericValue}" Minimum="{Binding MinNumericValue}" Maximum="{Binding MaxNumericValue}" Width="150" SmallChange="1" LargeChange="{Binding LargeNumericChange}"
                                                                                 IsVisible="{Binding NotTempoSync}"
                                                                                 AutomationProperties.AutomationId="data-explorer.details.tempo-value"
                                                                                 AutomationProperties.Name="{Binding Description}" />
                                                                        <TextBlock Text="{Binding NumericFormattedText}" Margin="{StaticResource ValueMargin}"
                                                                                    IsVisible="{Binding NotTempoSync}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.DataTemplates>
                                                        </ContentControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>
                                </DataTemplate>

                                <!-- Lists (always read-only) -->
                                <DataTemplate DataType="vmd:ListDataNodeDetailViewModel">
                                    <GroupBox Header="{Binding Description}"
                                              AutomationProperties.HeadingLevel="3"
                                              AutomationProperties.LandmarkType="ContentInfo">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
