<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmls="clr-namespace:VDrumExplorer.ViewModel.LogicalSchema;assembly=VDrumExplorer.ViewModel"
        x:Class="VDrumExplorer.Gui.Avalonia.Views.SchemaExplorer"
        x:CompileBindings="True"
        x:DataType="vmls:ModuleSchemaViewModel"
        Title="{Binding Title}" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Tree of container nodes. -->
        <TreeView x:Name="treeView" Grid.Column="0" BorderThickness="0" ItemsSource="{Binding Root}"
                  SelectionChanged="TreeView_SelectionChanged"
                  Margin="{StaticResource AllAroundMargin}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vmls:TreeNodeViewModel">
                    <TextBlock Text="{Binding Format.FormatString}" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <!-- Details for the selected node. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Column="2">
            <StackPanel Margin="5,0,5,0">
                <GroupBox Header="Tree node">
                    <ItemsControl ItemsSource="{Binding SelectedNode.Table}" ItemTemplate="{StaticResource KeyValueItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Grid.IsSharedSizeScope="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </GroupBox>
                <Separator />
                <ItemsControl ItemsSource="{Binding SelectedNode.Details}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vmls:FieldContainerNodeDetailViewModel" x:DataType="vmls:FieldContainerNodeDetailViewModel">
                            <GroupBox Header="{Binding Description}">
                                <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource KeyValueItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Grid.IsSharedSizeScope="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                        <DataTemplate DataType="vmls:ListNodeDetailViewModel" x:DataType="vmls:ListNodeDetailViewModel">
                            <GroupBox Header="{Binding Description}">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmls:FieldFormattableStringViewModel">
                                            <TextBlock Text="{Binding FormatString}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
