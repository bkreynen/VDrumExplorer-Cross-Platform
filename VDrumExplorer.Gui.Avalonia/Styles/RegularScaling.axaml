<!-- Styles used for defining size-sensitive data for regular development; these are merged in App.axaml -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window style with default font size -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Menu style with default font size -->
    <Style Selector="Menu">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Button style with padding and vertical alignment -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- We almost always align things centrally (vertically) -->
    <Style Selector="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock:disabled">
        <Setter Property="Foreground" Value="Gray" />
    </Style>
    <Style Selector="Label">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
